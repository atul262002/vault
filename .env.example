# Copy to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# --- App ------------------------------------------------------------------------
# Public base URL, used for links in emails and by the scheduler.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# --- Clerk (authentication) -----------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Razorpay / RazorpayX (payments, refunds, seller payouts) --------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# RazorpayX account number that seller payouts are sent from.
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=
# Secret configured on the Razorpay webhook (event: payment.captured) that
# points at https://your-domain.example/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Scheduler / cron -----------------------------------------------------------
# REQUIRED. The reminders job moves money and refuses to run without it.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Where scheduler.js sends its requests (defaults to NEXT_PUBLIC_APP_URL).
API_URL=http://localhost:3000/api/cron/reminders

# --- Admin panel ----------------------------------------------------------------
ADMIN_PANEL_USERNAME=admin
# Use a long random password; login is throttled but not rate-limited across instances.
ADMIN_PANEL_PASSWORD=change-me
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# Receives dispute, auto-refund and timeout alerts. Alerts are skipped if unset.
ADMIN_EMAIL=

# --- ImageKit (ticket images and transfer evidence) -------------------------------
NEXT_PUBLIC_PUBLIC_KEY=
PRIVATE_KEY=
NEXT_PUBLIC_URL_ENDPOINT=https://ik.imagekit.io/your_id/

# --- Email (SMTP) -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address shown on all outbound emails (defaults to support@vaultpay.co.in)
SMTP_FROM_EMAIL=support@vaultpay.co.in

# --- SMS / WhatsApp (Twilio, optional) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# WhatsApp redirect number (country code + number, no + or spaces, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# --- OpenAI (support chatbot) --------------------------------------------------------
OPENAI_APIKEY=
